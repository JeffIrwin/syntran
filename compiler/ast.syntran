// The syntax tree of the syntran port of the parser.  It mirrors the typed tree
// that the Fortran parser builds, `syntax_node_t` in src/types.f90, which
// `syntran --parse` dumps.  See compiler/parse.syntran and
// doc/compiler-roadmap.md
//
// Differences from the Fortran:
//
// - A child is an `i32` index into a `NodeVec`, the arena that owns every node,
//   instead of an allocatable member, because syntran structs can't hold
//   themselves and have value semantics.  An index of -1 is a child that isn't
//   there, where the Fortran member isn't allocated
// - Kinds are an enum with the same names as the Fortran kinds, which the dump
//   prints with `std::variant_of()`
// - A type is a `Type` struct instead of a `value_t`, since a type is all of a
//   value that the tree needs so far.  `type_name()` is `value_type_name()`
// - A literal's value is its text, as the Fortran `value_t%to_str()` prints it
// - Only the members that the milestones so far need are here.  Each milestone
//   adds the ones that it needs

use lex::*;

//==============================================================================

enum NodeKind
{
	unknown,
	translation_unit,
	literal_expr,
	name_expr,
	unary_expr,
	binary_expr,
	let_expr,
	assignment_expr,
	block_statement,
	if_statement,
	while_statement,
	for_statement,
	array_expr,
	return_statement,
	break_statement,
	continue_statement,
}

enum TypeKind
{
	// The Fortran `*_type` parameters, minus the suffix, and `null_` has a
	// trailing `_` since `null` is a keyword

	unknown,
	void,
	bool,
	i32,
	i64,
	f32,
	f64,
	str,
	array,
	any,
	null_,
	file,
}

struct Type
{
	// Like the type part of `value_t`.  For an array, `kind` is `array` and
	// `elem` and `rank` say what is in it.  `elem` and `rank` are only
	// meaningful for an array

	kind: TypeKind,
	elem: TypeKind,
	rank: i32,
}

fn new_type(kind: TypeKind): Type
{
	return Type
	{
		kind = kind,
		elem = TypeKind.unknown,
		rank = 0,
	};
}

fn new_array_type(elem: TypeKind, rank: i32): Type
{
	return Type
	{
		kind = TypeKind.array,
		elem = elem,
		rank = rank,
	};
}

fn type_name_primitive(kind: TypeKind): str
{
	// Like `value_type_name_primitive()`.  Only some kinds have a name, and
	// the rest are `"unknown"`, including a file
	switch kind
	{
		case TypeKind.void  { return "void"; }
		case TypeKind.bool  { return "bool"; }
		case TypeKind.i32   { return "i32"; }
		case TypeKind.i64   { return "i64"; }
		case TypeKind.f32   { return "f32"; }
		case TypeKind.f64   { return "f64"; }
		case TypeKind.str   { return "str"; }
		case TypeKind.any   { return "any"; }
		case TypeKind.null_ { return "null"; }
	}
	return "unknown";
}

fn type_name(ty: &const Type): str
{
	// Like `value_type_name()`, e.g. `"i32"`, `"[f64; :]"`, or `"[i32; :, :]"`
	if ty.kind != TypeKind.array
		return type_name_primitive(ty.kind);

	return "[" + type_name_primitive(ty.elem) + "; " +
		std::repeat(":, ", ty.rank - 1) + ":]";
}

fn is_num_type(kind: TypeKind): bool
{
	return any(kind == [
		TypeKind.i32, TypeKind.i64, TypeKind.f32, TypeKind.f64,
	]);
}

fn is_int_type(kind: TypeKind): bool
{
	return any(kind == [TypeKind.i32, TypeKind.i64]);
}

//==============================================================================

struct Node
{
	// Like `syntax_node_t`

	kind: NodeKind,

	// The tokens, which are only meaningful if the `has_` flag is set, like
	// the Fortran members that are allocated
	has_id: bool,
	identifier: Token,
	has_op: bool,
	op: Token,

	type_: Type,

	// The slot of a variable, which is 0-based unlike the Fortran's, and -1 if
	// there isn't one
	id_index: i32,
	is_loc: bool,

	// The value of a literal
	val: str,

	// The 0-based position of a statement in the source, or -1
	src_pos: i32,

	// Indices of the children in the arena, or -1
	left: i32,
	right: i32,
	condition: i32,
	if_clause: i32,
	else_clause: i32,
	body: i32,
	array: i32,
	lbound: i32,
	step: i32,
	ubound: i32,

	// Indices of the children in the arena, in the order of the Fortran
	// `members(:)`
	members: [i32; :],
}

fn new_node(kind: NodeKind): Node
{
	return Node
	{
		kind = kind,
		has_id = false,
		identifier = new_token(TokenKind.eof, 0, ""),
		has_op = false,
		op = new_token(TokenKind.eof, 0, ""),
		type_ = new_type(TypeKind.unknown),
		id_index = -1,
		is_loc = false,
		val = "",
		src_pos = -1,
		left = -1,
		right = -1,
		condition = -1,
		if_clause = -1,
		else_clause = -1,
		body = -1,
		array = -1,
		lbound = -1,
		step = -1,
		ubound = -1,
		members = [0; 0],
	};
}

//==============================================================================

struct NodeVec
{
	// A growable array of nodes, like samples/vec_i32.syntran.  It is the arena
	// of a tree

	len: i32,
	cap: i32,
	data: [Node; :],

	fn push(node: &const Node): i32
	{
		// Returns the index of the node that was pushed
		if len >= cap
		{
			let new_cap = 16;
			if cap > 0
				new_cap = cap * 2;

			let new_data = [
				data,
				[new_node(NodeKind.unknown); new_cap - cap],
			];
			data = std::move(new_data);
			cap = new_cap;
		}
		data[len] = node;
		len += 1;
		return len - 1;
	}
}

fn new_node_vec(): NodeVec
{
	return NodeVec
	{
		len = 0,
		cap = 0,
		data = [new_node(NodeKind.unknown); 0],
	};
}

//==============================================================================

struct I32Vec
{
	// A growable array of i32s, like samples/vec_i32.syntran.  It collects the
	// indices of a node's list members

	len: i32,
	cap: i32,
	data: [i32; :],

	fn push(x: i32)
	{
		if len >= cap
		{
			let new_cap = 16;
			if cap > 0
				new_cap = cap * 2;

			let new_data = [data, [0; new_cap - cap]];
			data = std::move(new_data);
			cap = new_cap;
		}
		data[len] = x;
		len += 1;
		return;
	}

	const fn to_array(): [i32; :]
	{
		return data[0: len];
	}
}

fn new_i32_vec(): I32Vec
{
	return I32Vec
	{
		len = 0,
		cap = 0,
		data = [0; 0],
	};
}

//==============================================================================

struct Diag
{
	// A diagnostic of the parser, like the Fortran one but without the message
	// text.  `pos` is the 0-based position of its span in the source, or -1 for
	// a lexer diagnostic, which has none.  `len` is the length of the span,
	// which is 0 until a check needs it for its caret

	code: str,
	pos: i32,
	len: i32,
}

fn new_diag(code: &const str, pos: i32): Diag
{
	return Diag
	{
		code = code,
		pos = pos,
		len = 0,
	};
}

struct DiagVec
{
	// A growable array of diagnostics, like samples/vec_i32.syntran

	len: i32,
	cap: i32,
	data: [Diag; :],

	fn push(diag: &const Diag)
	{
		if len >= cap
		{
			let new_cap = 16;
			if cap > 0
				new_cap = cap * 2;

			let new_data = [data, [new_diag("", -1); new_cap - cap]];
			data = std::move(new_data);
			cap = new_cap;
		}
		data[len] = diag;
		len += 1;
		return;
	}
}

fn new_diag_vec(): DiagVec
{
	return DiagVec
	{
		len = 0,
		cap = 0,
		data = [new_diag("", -1); 0],
	};
}

//==============================================================================

fn is_assignment_op(token: &const Token): bool
{
	// Is the operator an assignment operator, either regular or compound?
	return any(token.kind == [
		TokenKind.equals, TokenKind.plus_equals, TokenKind.minus_equals,
		TokenKind.star_equals, TokenKind.slash_equals,
		TokenKind.double_star_equals, TokenKind.percent_equals,
		TokenKind.amp_equals, TokenKind.pipe_equals, TokenKind.caret_equals,
		TokenKind.double_less_equals, TokenKind.double_greater_equals,
	]);
}

fn get_unary_op_prec(token: &const Token): i32
{
	// Unary operator precedence, which is below `**` but above every other
	// binary operator.  See the Fortran for why
	switch token.kind
	{
		case TokenKind.plus, TokenKind.minus, TokenKind.bang { return 11; }
		case TokenKind.keyword when token.keyword == Keyword.not_ { return 11; }
	}
	return 0;
}

fn get_binary_op_prec(token: &const Token): i32
{
	// Binary operator precedence.  A higher number is a higher precedence
	switch token.kind
	{
		case TokenKind.double_star { return 12; }
		case TokenKind.star, TokenKind.slash, TokenKind.percent,
			TokenKind.matmul { return 10; }
		case TokenKind.plus, TokenKind.minus { return 9; }
		case TokenKind.double_less, TokenKind.double_greater { return 8; }
		case TokenKind.amp { return 7; }
		case TokenKind.caret { return 6; }
		case TokenKind.pipe { return 5; }
		case TokenKind.less, TokenKind.less_equals, TokenKind.greater,
			TokenKind.greater_equals { return 4; }
		case TokenKind.double_equals, TokenKind.bang_equals { return 3; }
		case TokenKind.keyword when token.keyword == Keyword.and_ { return 2; }
		case TokenKind.keyword when token.keyword == Keyword.or_ { return 1; }
	}
	return 0;
}

//==============================================================================

fn is_comparison_op(token: &const Token): bool
{
	return any(token.kind == [
		TokenKind.double_equals, TokenKind.bang_equals, TokenKind.less,
		TokenKind.less_equals, TokenKind.greater, TokenKind.greater_equals,
	]);
}

fn is_array_elem(kind: TypeKind): bool
{
	// Does an array of these have an array type in the Fortran?  The others,
	// like a struct, have no `*_array_type`
	return any(kind == [
		TypeKind.bool, TypeKind.f32, TypeKind.f64, TypeKind.i32, TypeKind.i64,
		TypeKind.str,
	]);
}

fn get_binary_scalar_kind(left: TypeKind, right: TypeKind): TypeKind
{
	// The default case of the Fortran `get_binary_op_kind()` for two scalars:
	// the same type, or promoted to the wider one
	if any([left, right] == TypeKind.unknown)
		return TypeKind.unknown;
	if left == right
		return left;
	if any([left, right] == TypeKind.f64)
		return TypeKind.f64;
	if any([left, right] == TypeKind.f32)
		return TypeKind.f32;
	if (left == TypeKind.i64 and is_int_type(right)) or
		(right == TypeKind.i64 and is_int_type(left))
		return TypeKind.i64;
	return TypeKind.unknown;
}

fn array_rank(left: &const Type, right: &const Type): i32
{
	// The rank of the result of an elementwise operation, which is the left
	// operand's if it is an array
	if left.kind == TypeKind.array
		return left.rank;
	return right.rank;
}

fn get_binary_op_kind(
	left: &const Type, op: &const Token, right: &const Type,
): Type
{
	// The type of the result of `left op right`.  This is the Fortran
	// `get_binary_op_kind()` followed by what `new_binary_expr()` makes of it
	// (but not for `@`, see `get_matmul_kind()`)
	if left.kind == TypeKind.unknown or right.kind == TypeKind.unknown
		return new_type(TypeKind.unknown);

	const either_array = left.kind == TypeKind.array or
		right.kind == TypeKind.array;

	if is_comparison_op(op)
	{
		// Always a bool of some rank
		if either_array
			return new_array_type(TypeKind.bool, array_rank(left, right));
		return new_type(TypeKind.bool);
	}

	if any(op.kind == [TokenKind.double_less, TokenKind.double_greater])
	{
		// A shift is the type of its left operand if both are scalars
		if not either_array
			return left;

		let elem = TypeKind.i64;
		if left.kind == TypeKind.array
		{
			if left.elem == TypeKind.i32
				elem = TypeKind.i32;
		}
		else if left.kind == TypeKind.i32
		{
			elem = TypeKind.i32;
		}
		return new_array_type(elem, array_rank(left, right));
	}

	// An array operand is combined with the other operand elementwise, and an
	// element that has no array type makes the result unknown
	let lkind = left.kind;
	if left.kind == TypeKind.array
		lkind = left.elem;
	let rkind = right.kind;
	if right.kind == TypeKind.array
		rkind = right.elem;

	const kind = get_binary_scalar_kind(lkind, rkind);
	if not either_array
		return new_type(kind);
	if is_array_elem(kind)
		return new_array_type(kind, array_rank(left, right));
	return new_type(TypeKind.unknown);
}

fn matmul_out_rank(lrank: i32, rrank: i32): i32
{
	// The rank of `@`:  matrix @ matrix is a matrix, vector @ vector is a
	// scalar, and the rest are vectors
	if lrank == 1 and rrank == 1
		return 0;
	if lrank == 2 and rrank == 2
		return 2;
	return 1;
}

fn get_matmul_kind(left: &const Type, right: &const Type): Type
{
	// The type of `left @ right`, from the Fortran `new_binary_expr()`.  The
	// element type is promoted like `*` does, and the rank comes from the
	// operands.  An operand that isn't an array has no element type or rank
	let lelem = TypeKind.unknown;
	let lrank = -1;
	if left.kind == TypeKind.array
	{
		lelem = left.elem;
		lrank = left.rank;
	}
	let relem = TypeKind.unknown;
	let rrank = -1;
	if right.kind == TypeKind.array
	{
		relem = right.elem;
		rrank = right.rank;
	}

	const elem = get_binary_scalar_kind(lelem, relem);
	const rank = matmul_out_rank(lrank, rrank);
	if rank == 0
		return new_type(elem);
	return new_array_type(elem, rank);
}
