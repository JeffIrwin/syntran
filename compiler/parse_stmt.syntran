// Statements for the syntran port of the parser, like the statement half of
// src/parse_control.f90.  This file isn't a module, it is `#include`d by
// compiler/parse.syntran.  See compiler/parse.syntran

//==============================================================================

fn parse_return_statement(parser: &Parser): i32
{
	expect_keyword(&parser, Keyword.return_);

	let node = new_node(NodeKind.return_statement);
	if peek_kind(parser, 0) == TokenKind.semicolon
	{
		// A void return, which is a node with no kind, and the void type
		let right = new_node(NodeKind.unknown);
		right.type_ = new_type(TypeKind.void);
		node.right = parser.nodes.push(right);
	}
	else
	{
		node.right = parse_expr(&parser, 0);
	}
	expect(&parser, TokenKind.semicolon);
	return parser.nodes.push(node);
}

fn parse_break_statement(parser: &Parser): i32
{
	expect_keyword(&parser, Keyword.break_);
	expect(&parser, TokenKind.semicolon);
	return parser.nodes.push(new_node(NodeKind.break_statement));
}

fn parse_continue_statement(parser: &Parser): i32
{
	expect_keyword(&parser, Keyword.continue_);
	expect(&parser, TokenKind.semicolon);
	return parser.nodes.push(new_node(NodeKind.continue_statement));
}

fn parse_scoped_statement(parser: &Parser): i32
{
	// A braceless body, like `if c let x = 1;`, gets its own scope like a block
	// does, so its `let` can't leak out to code where it never ran
	parser.vars.push_scope();
	const statement = parse_statement(&parser);
	parser.vars.pop_scope();
	return statement;
}

fn parse_if_statement(parser: &Parser): i32
{
	expect_keyword(&parser, Keyword.if_);

	let node = new_node(NodeKind.if_statement);
	node.condition = parse_expr(&parser, 0);
	node.if_clause = parse_scoped_statement(&parser);

	// No more work is needed for "else if".  That's just an else clause that is
	// another if statement
	if is_keyword(parser, 0, Keyword.else_)
	{
		expect_keyword(&parser, Keyword.else_);
		node.else_clause = parse_scoped_statement(&parser);
	}
	return parser.nodes.push(node);
}

fn parse_for_statement(parser: &Parser): i32
{
	// For loop syntax:
	//
	//     for i in [1: 5] { ... }          // 1, 2, 3, 4
	//     for i in [1: 2: 7] { ... }       // 1, 3, 5
	expect_keyword(&parser, Keyword.for_);

	parser.vars.push_scope();

	const identifier = match(&parser, TokenKind.identifier);
	expect_keyword(&parser, Keyword.in_);

	let node = new_node(NodeKind.for_statement);
	node.has_id = true;
	node.identifier = identifier;
	const array_pos = peek_pos(parser, 0);
	node.array = parse_primary_expr(&parser);

	// The iterator is declared after the array, so the array can't use it
	node.id_index = push_var(&parser);

	// The type of the iterator is the type of the elements of the array, or
	// the str itself.  An array of arrays has no scalar to iterate over
	const array_type = type_of(parser, node.array);
	let iter_type = array_type;
	if array_type.kind == TypeKind.array
	{
		iter_type = new_type(array_type.elem);
		if array_type.elem == TypeKind.array
			iter_type = new_type(TypeKind.unknown);
	}
	const ok = parser.vars.insert(
		identifier.text, iter_type, node.id_index, false
	);

	// Only an array or a str can be looped over, like the Fortran E51, which
	// is also pushed for an unknown type
	if not any(array_type.kind == [TypeKind.array, TypeKind.str])
		push_diag(&parser, "E51", array_pos);

	node.body = parse_statement(&parser);

	parser.vars.pop_scope();
	return parser.nodes.push(node);
}

fn parse_while_statement(parser: &Parser): i32
{
	expect_keyword(&parser, Keyword.while_);

	let node = new_node(NodeKind.while_statement);
	node.condition = parse_expr(&parser, 0);
	node.body = parse_scoped_statement(&parser);
	return parser.nodes.push(node);
}

fn parse_block_statement(parser: &Parser): i32
{
	let members = new_i32_vec();

	expect(&parser, TokenKind.lbrace);
	parser.vars.push_scope();

	while not any(peek_kind(parser, 0) == [TokenKind.eof, TokenKind.rbrace])
	{
		const pos0 = parser.pos;
		members.push(parse_statement(&parser));

		// Avoid infinite loops on malformed blocks
		if parser.pos == pos0
			skip(&parser);
	}

	parser.vars.pop_scope();
	expect(&parser, TokenKind.rbrace);

	let node = new_node(NodeKind.block_statement);
	node.members = members.to_array();
	return parser.nodes.push(node);
}

fn parse_statement(parser: &Parser): i32
{
	// The position of the statement, which every kind gets stamped with, for
	// stack traces at runtime
	const src_pos = peek_pos(parser, 0);

	const current = peek_token(parser, 0);

	let statement = -1;
	switch current.kind
	{
		case TokenKind.lbrace
		{
			statement = parse_block_statement(&parser);
		}
		case TokenKind.keyword when current.keyword == Keyword.if_
		{
			statement = parse_if_statement(&parser);
		}
		case TokenKind.keyword when current.keyword == Keyword.for_
		{
			statement = parse_for_statement(&parser);
		}
		case TokenKind.keyword when current.keyword == Keyword.while_
		{
			statement = parse_while_statement(&parser);
		}
		case TokenKind.keyword when current.keyword == Keyword.return_
		{
			statement = parse_return_statement(&parser);
		}
		case TokenKind.keyword when current.keyword == Keyword.break_
		{
			statement = parse_break_statement(&parser);
		}
		case TokenKind.keyword when current.keyword == Keyword.continue_
		{
			statement = parse_continue_statement(&parser);
		}

		// A switch is milestone 5, and a use is milestone 6
		case TokenKind.keyword when
			any(current.keyword == [Keyword.switch_, Keyword.use_])
		{
			statement = unsupported(&parser);
		}
		default
		{
			statement = parse_expr_statement(&parser);
			expect(&parser, TokenKind.semicolon);

			// Ban expression statements, which are only allowed in the REPL.
			// It's easier to parse one unconditionally and check it afterwards.
			// A statement of unknown type was tainted by a prior error, so skip
			// it to avoid cascading an E9
			const kind = parser.nodes.data[statement].kind;
			const type_kind = type_of(parser, statement).kind;
			if not parser.repl and type_kind != TypeKind.unknown and
				not any(kind == [NodeKind.let_expr, NodeKind.assignment_expr])
				push_diag(&parser, "E9", src_pos);
		}
	}

	parser.nodes.data[statement].src_pos = src_pos;
	return statement;
}
