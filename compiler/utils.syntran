// Small helpers for the self-hosted compiler that don't depend on any of its
// types: escaping for the dumps, character classes, digit and number
// conversion, and a growable array of strs.  The lexer, compiler/lex.syntran,
// is the first user.  c.f. src/utils_impl.f90 for the character classes

//==============================================================================

// Control chars, which have no literal in a syntran str
const NULL_CHAR       = char(0);
const TAB             = char(9);
const LINE_FEED       = char(10);
const VERT_TAB        = char(11);
const CARRIAGE_RETURN = char(13);

fn at(s: &const str, i: i32): str
{
	// Syntran's `and` and `or` don't short-circuit, so `i < n and s[i] == "x"`
	// reads past the end of `s`.  This gets a char, or `NULL_CHAR` if `i` is
	// out of range
	if i < 0 or i >= len(s)
		return NULL_CHAR;
	return s[i];
}

fn escape(s: &const str): str
{
	// Escape a token's text or value for the dump of the lexer and the parser,
	// so that a token or node is always one line, with no tabs in it.  Bytes >=
	// 128 are left alone.  Syntran strs have no escapes, so a lone backslash is
	// `"\"`
	let out = "";
	for c in s
	{
		switch c
		{
			case r#"\"#          { out += "\\"; }
			case LINE_FEED       { out += "\n"; }
			case CARRIAGE_RETURN { out += "\r"; }
			case TAB             { out += "\t"; }
			case NULL_CHAR       { out += "\0"; }
			default              { out += c; }
		}
	}
	return out;
}

// Character classes.  A `c` is a str of length 1
fn is_digit(c: str): bool
{
	return "0" <= c and c <= "9";
}

fn is_digit_under(c: str): bool
{
	return is_digit(c) or c == "_";
}

fn is_hex(c: str): bool
{
	return is_digit(c) or ("a" <= c and c <= "f") or ("A" <= c and c <= "F");
}

fn is_hex_under(c: str): bool
{
	return is_hex(c) or c == "_";
}

fn is_oct_under(c: str): bool
{
	return ("0" <= c and c <= "7") or c == "_";
}

fn is_bin_under(c: str): bool
{
	return c == "0" or c == "1" or c == "_";
}

fn is_sign(c: str): bool
{
	return c == "+" or c == "-";
}

fn is_expo(c: str): bool
{
	return c == "d" or c == "e" or c == "D" or c == "E";
}

fn is_float_under(c: str): bool
{
	return is_digit(c) or is_sign(c) or is_expo(c) or c == "." or c == "_";
}

fn is_letter(c: str): bool
{
	return ("a" <= c and c <= "z") or ("A" <= c and c <= "Z");
}

fn is_alphanum(c: str): bool
{
	return is_letter(c) or is_digit(c);
}

fn is_alphanum_under(c: str): bool
{
	return is_alphanum(c) or c == "_";
}

fn is_whitespace(c: str): bool
{
	return c == " " or c == TAB or c == LINE_FEED or c == VERT_TAB
		or c == CARRIAGE_RETURN;
}

//==============================================================================

fn rm_char(s: &const str, ch: str): str
{
	// Remove all occurrences of the char `ch` from `s`
	let out = "";
	for i in [0: len(s)]
		if s[i] != ch
			out += s[i];
	return out;
}

fn rm_leading_zeros(s: &const str): str
{
	// Strip leading zeros, but leave 1 digit, so "000" is "0"
	if len(s) == 0
		return "";

	let i = 0;
	while i < len(s) - 1
	{
		if s[i] != "0"
			break;
		i += 1;
	}
	return s[i:];
}

fn digit_val(c: str): i32
{
	// The value of a hex, octal, or binary digit
	if is_digit(c)
		return i32(c) - i32("0");
	if "a" <= c and c <= "f"
		return i32(c) - i32("a") + 10;
	return i32(c) - i32("A") + 10;
}

fn bit_len(d: i32): i32
{
	// The number of bits that it takes to hold a digit, which is < 16
	let n = 0;
	let x = d;
	while x > 0
	{
		n += 1;
		x = x >> 1;
	}
	return n;
}

fn sig_bits(digits: &const str, k: i32): i64
{
	// The number of significant bits in a string of hex, octal, or binary
	// digits, where `k` is the number of bits per digit.  There are no leading
	// zeros except for a lone "0"
	if digits == "0"
		return 0'i64;
	return bit_len(digit_val(digits[0])) + k * (len(digits) - 1);
}

fn radix_val(digits: &const str, k: i32): i64
{
	// Digits to a value, as the bits of an i64, for a number of up to 64 bits
	let val = 0'i64;
	for i in [0: len(digits)]
		val = (val << k) | i64(digit_val(digits[i]));
	return val;
}

fn to_i32(val: i64): i32
{
	// Wrap an i64 that holds the bits of an unsigned 32-bit number as an i32
	if val >= 0x8000_0000'i64
		return i32(val - 0x1_0000_0000'i64);
	return i32(val);
}

//==============================================================================

struct StrVec
{
	// A growable array of strs, like samples/vec_i32.syntran.  `len` is the
	// number of strs that are in use, and `cap` is the allocated size of `data`

	len: i32,
	cap: i32,
	data: [str; :],

	fn push(s: &const str)
	{
		if len >= cap
		{
			let new_cap = 16;
			if cap > 0
				new_cap = cap * 2;

			let new_data = [data, [""; new_cap - cap]];
			data = std::move(new_data);
			cap = new_cap;
		}
		data[len] = s;
		len += 1;
		return;
	}
}

fn new_str_vec(): StrVec
{
	return StrVec
	{
		len = 0,
		cap = 0,
		data = [""; 0],
	};
}
