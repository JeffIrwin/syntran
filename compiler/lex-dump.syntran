
// Dump the tokens of a file from the syntran lexer, in the same format as
// `syntran --lex` does for the Fortran lexer, so the two can be diffed.  See
// lex_dump() in src/lex.f90 for the format, and utils/test-lex.sh
//
// Usage:
//
//     syntran -q compiler/lex-dump.syntran -- <file>
//
// Syntran has no way to read a whole file as a str.  readln() drops the line
// feed at the end of each line, so every line is given one back, except for a
// last line that doesn't have one, which is told apart by `f.eof` (see below)

use lex::*;

// Escape a token's text or value so that a token is always one line with
// tab-separated fields.  Bytes >= 128 are left alone.  Syntran strs have no
// escapes, so a lone backslash is "\"
fn escape(s: &const str): str
{
	let out = "";
	for i in [0: len(s)]
	{
		const c = s[i];
		if c == r#"\"#
			out += "\\";
		else if c == char(10)
			out += "\n";
		else if c == char(13)
			out += "\r";
		else if c == char(9)
			out += "\t";
		else if c == char(0)
			out += "\0";
		else
			out += c;
	}
	return out;
}

// The name of an enum variant, which is what `str()` makes of an enum without its
// `TokenKind.` prefix, and without the trailing `_` of a keyword, e.g. "plus"
fn variant_name(s: &const str): str
{
	let i = 0;
	while s[i] != "."
		i += 1;
	const name = s[i + 1:];
	if name[len(name) - 1] == "_"
		return name[0: len(name) - 1];
	return name;
}

// The name of a token's kind in the Fortran lexer, e.g. "plus_token" or
// "let_keyword".  The enums here leave off the suffixes
fn kind_name(token: &const Token): str
{
	if token.kind == TokenKind.keyword
		return variant_name(str(token.keyword)) + "_keyword";
	return variant_name(str(token.kind)) + "_token";
}

fn read_text(path: &const str): str
{
	let f = std::open(path, "r");
	let text = "";
	while true
	{
		const line = readln(f);
		if f.eof
		{
			// Reading past the end is an empty line.  But a last line without a
			// line feed sets eof as soon as it's read, and it isn't empty
			text += line;
			break;
		}
		text += line + char(10);
	}
	close(f);
	return text;
}

fn main()
{
	const args = std::args();
	if size(args) < 1
	{
		println("usage: lex-dump.syntran -- <file>");
		std::exit(1);
	}

	const text = read_text(args[0]);

	let lexer = new_lexer(text);
	const tokens = lex_all(&lexer);

	const tab = char(9);
	for i in [0: tokens.len]
	{
		const t = tokens.data[i];
		let line = str(t.pos) + tab + kind_name(t) + tab + escape(t.text);

		if t.kind == TokenKind.i32
			line += tab + str(t.i32_);
		else if t.kind == TokenKind.i64
			line += tab + str(t.i64_);
		else if t.kind == TokenKind.f32
			line += tab + str(t.f32_);
		else if t.kind == TokenKind.f64
			line += tab + str(t.f64_);
		else if t.kind == TokenKind.str
			line += tab + escape(t.str_);

		println(line);
	}

	for i in [0: lexer.diags.len]
		println("diag ", lexer.diags.data[i]);
}

main();
