
struct Stack_vec_i32
{
	vals: [i32; :,:],
	len: i32, // stack size
	cap: i32,
	vec_len: i32, // size of a single pushed/popped vector value
	is_init : bool, // vec size is set on first push

	fn push(val: &const [i32; :])
	{
		if is_init
		{
			if size(val) != size(vals,0)
			{
				println("Error: cannot push stack value with inconsistent size");
				exit(2);
			}
		}
		is_init = true;

		if cap == 0 or len == cap
		{
			//println("resizing");
			let new_cap = 1;
			if cap > 0
				new_cap = cap * 2;

			// Note syntran cannot move yet, so we need two copies here where
			// other languages could optimally do only one copy
			let new_vals = [0; size(val), new_cap];
			new_vals[:, 0:len] = vals;
			vals = new_vals;
			cap = new_cap;
		}

		vals[:,len] = val;
		len += 1;
	}

	fn pop(): [i32; :]
	{
		len -= 1;
		if len < 0
		{
			println("Error: cannot pop empty stack");
			exit(1);
		}
		return vals[:,len];
	}
}
fn new(): Stack_vec_i32
{
	return Stack_vec_i32
	{
		vals = [0; 0, 0],
		len = 0,
		cap = 0,
		vec_len = 0,
		is_init = false,
	};
}

