// TODO: rename to any_str_eq_vec
fn any_str_eq(str_: &const str, v: &const [str; :]): bool
{
	//if (any_str_eq(my_num, wn_nums_str)) nwin = 1;

	let found = false;
	let i = 0;
	while i < size(v, 0) and not found
	{
		found = str_ == v[i];
		i += 1;
	}
	return found;
}

