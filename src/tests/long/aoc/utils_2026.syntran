
// In the time since I originally wrote this in 2023, there are a lot of things
// that could be cleaned up or outright removed from these utils, thanks to new
// syntran features.  For example, abs_i32() and sum_i32() implemented here now
// have better alternatives built in to syntran
//
// However, this is large and well-tested, so I'm afraid to change it.  Maybe
// after 2024

//==============================================================================

const digit_chars = "0123456789";
const hex_chars = digit_chars + "abcdef";
const NEWLINE_ = char(10);

// I'm considering making these syntran std:: consts. Need to be careful, most
// of these are also bold but boldness and color should be independent
const ESC = char(27);
const BOLD    = ESC + "[;1m";
const RED     = ESC + "[1;31m";
const GREEN   = ESC + "[1;32m";
const YELLOW  = ESC + "[1;33m";
const MAGENTA = ESC + "[1;35m";
const RESET   = ESC + "[0m";

const WARN_STR  = YELLOW + "Warning" + RESET + ": ";
const ERROR_STR = RED    + "Error"   + RESET + ": ";

//****************

struct Args
{
	test  : bool,
	assert: bool,
	part1 : bool, // true iff --part1 cmd arg is present
	part2 : bool,
	help  : bool,

	has_input_filename: bool,
	input_filename: str,

	// See the logic in parse_args. If you omit --part1 and --part2 cmd args,
	// these are both true -- the default is to do both parts unless the user
	// passes only one part arg
	do_p1: bool, // redundant with part1, packaged here for convenience
	do_p2: bool,
}

//==============================================================================

fn parse_args(): Args
{
	// Parse the command line arguments
	//
	// Based on https://github.com/JeffIrwin/aoc-fortran/blob/12830bb004a5e70d20d55d455a5077050488cfff/src/args.F90#L48
	let args = std::args();
	let nargs = size(args);

	let a = Args{test=false, assert=false, part1=false, part2=false,
		help=false, has_input_filename=false, input_filename="input.txt",
		do_p1=true, do_p2=true,
	};

	let i = 0;
	let ipos = 0; // positional arg index -- unused
	while i < nargs
	{
		let arg = args[i];
		if any(arg == ["-h", "--help", "-help"])
			a.help = true;
		else if arg == "-t" or arg == "--test"
		{
			a.test = true;
			if not a.has_input_filename
				a.input_filename = "test-input.txt";
		}
		else if arg == "-a" or arg == "--assert"
			a.assert = true;
		else if arg == "-1" or arg == "--part1"
			a.part1 = true;
		else if arg == "-2" or arg == "--part2"
			a.part2 = true;
		else if arg == "-i" or arg == "--input"
		{
			i += 1;
			// TODO: error if i >= nargs ? I think my Fortran parser fails to
			// enforce this as well
			a.has_input_filename = true;
			a.input_filename = args[i];
		}
		else
			println(WARN_STR + "bad command argument """, arg, """");
		i += 1;
	}

	if a.help
	{
		println(BOLD + "Usage:" + RESET);
		println("    syntran main.syntran -- -h | --help");
		println("    syntran main.syntran -- [-1 | --part1] [-2 | --part2]");
		println("    syntran main.syntran -- [-t | --test] [(-i|--input) file.txt]");
		println("    syntran main.syntran -- -a | --assert");
		println();
		println(BOLD + "Options:" + RESET);
		println("    --help        Show this help");
		println("    --part1       Run part 1 only. Default both parts");
		println("    --part2       Run part 2 only");
		println("    --test        Use test-input.txt instead of input.txt");
		println("    --input       Input data filename");
		println("    --assert      Abort if results do not match expected answers");
		exit(0);
	}

	if (a.part1 and not a.part2) a.do_p2 = false;
	if (a.part2 and not a.part1) a.do_p1 = false;

	return a;
}

fn check_aoc_results(args: Args,
		p1: str, p2: str,
		expect1: str, expect2: str,
		expect1_test: str, expect2_test: str)
{
	let e1 = expect1;
	let e2 = expect2;
	if args.assert
	{
		let error = false;
		if args.test
		{
			e1 = expect1_test;
			e2 = expect2_test;
		}

		if args.do_p1 and p1 != e1
		{
			println(ERROR_STR + "wrong part 1 answer.  Got """ +
				p1 + """, expected """ + e1 + """");
			error = true;
		}
		if args.do_p2 and p2 != e2
		{
			println(ERROR_STR + "wrong part 2 answer.  Got """ +
				p2 + """, expected """ + e2 + """");
			error = true;
		}
		if (error) exit(1);
	}
	return;
}

//==============================================================================

fn countln_(filename: str): i32
{
	//println("starting countln_");
	let nlines = 0;

	let f = open(filename, "r");
	let str_ = readln(f);
	//println("str_ = ", str_);
	while not eof(f)
	{
		//println("str_ = ", str_);
		nlines += 1;

		str_ = readln(f);
	}
	if (str_ != "") nlines += 1;  // allow no newline at eof
	close(f);

	return nlines;
}

//==============================================================================

fn scan(str_: &const str, set: &const str): i64
{
	// c.f. Fortran intrinsic scan()

	//println("str_ = ", str_);
	//println("set = ", set);

	let found = false;
	let i = i64(0);
	while not found and i < len(str_)
	{

		let j = 0;
		while not found and j < len(set)
		{
			found = str_[i] == set[j];
			j += 1;
		}
		i += 1;
	}

	if (found)
		i -= 1;
	else
		i = i64(-1);
	return i;
}

//==========================================================

fn scanback(str_: &const str, set: &const str): i64
{
	// c.f. Fortran intrinsic scan() with back = true

	//println("str_ = ", str_);
	//println("set = ", set);

	let found = false;
	let i = len(str_) - 1;
	while not found and i >= 0
	{

		let j = i64(0);
		while not found and j < len(set)
		{
			found = str_[i] == set[j];
			j += 1;
		}
		i -= 1;
	}
	//println("found = ", found);

	if (found)
		i += 1;
	else
		i = i64(-1);
	return i;
}

//==========================================================

fn verify(str_: &const str, set: &const str): i64
{
	// c.f. Fortran intrinsic verify()

	//println("starting verify()");
	//println("str_ = """, str_, """");
	//println("set = ", set);

	let found = true;
	let i = i64(0);
	while found and i < len(str_)
	{
		//println(i);

		let j = 0;
		found = false;
		while not found and j < len(set)
		{
			found = str_[i] == set[j];
			j += 1;
		}
		i += 1;
	}

	if (not found)
		i -= 1;
	else
		i = i64(-1);
	return i;
}

//==========================================================

fn tok_i32(str_: &const str): [i64; :]
{
	// tokenize a string into the first int contained within it, then return the
	// substring start index, end index, and length
	//
	// Some of these fns could be simplified with pass-by-ref to return multiple
	// vals, but there's no huge perf impact

	//println("starting tok_i32()");
	//println("str_ = """, str_, """");

	let nums = "1234567890";
	let beg_ = scan    (str_, nums);
	//println("beg_ = ", beg_);

	let n = len(str_);
	//println("n = ", n);

	// nasty bug which was just fixed
	let len_ = i64(-1);
	if (beg_ >= 0)
		len_ = verify(str_[beg_:n], nums);
	//println("len_ = ", len_);

	let end_ = i64(-1);
	if (beg_ < 0)
	{
		//println("no beg_");
	}
	else if (len_ < 0)
	{
		// This is consistent with the way that verify() works in Fortran
		end_ = n - 1;
		len_ = end_ - beg_ + 1;
	}
	else
		end_ = beg_ + len_ - 1;

	//println("beg_ = ", beg_);
	//println("end_ = ", end_);

	//println("num beg = ", str_[beg_]);
	//println("num end = ", str_[end_]);
	//println("num str = ", str_[beg_: end_+1]);

	return [beg_, end_, len_];
}

fn tok_mi32(str_: &const str): [i64; :]
{
	// tokenize a string into the first int contained within it, then return the
	// substring start index, end index, and length

	let nums = "-1234567890";
	let beg_ = scan    (str_, nums);
	//println("beg_ = ", beg_);

	let n = len(str_);
	//println("n = ", n);

	let len_ = i64(-1);
	if (beg_ >= 0)
		len_ = verify(str_[beg_:n], nums);
	//println("len_ = ", len_);

	let end_ = i64(-1);
	if (beg_ < 0)
	{
		//println("no beg_");
	}
	else if (len_ < 0)
	{
		// This is consistent with the way that verify() works in Fortran
		end_ = n - 1;
		len_ = end_ - beg_ + 1;
	}
	else
		end_ = beg_ + len_ - 1;

	//println("beg_ = ", beg_);
	//println("end_ = ", end_);

	//println("num beg = ", str_[beg_]);
	//println("num end = ", str_[end_]);
	//println("num str = ", str_[beg_: end_+1]);

	return [beg_, end_, len_];
}

//==========================================================

fn read_i32(str_: &const str): i32
{
	let toks = tok_i32(str_);

	// multiple return vals are packed into a vec bc i don't have structs :sad:
	let beg_ = toks[0];
	let end_ = toks[1];
	//let len_ = toks[2]; // not needed

	//println("read_i32 substr = ", str_[beg_: end_+1]);

	let ans = parse_i32(str_[beg_: end_+1]);
	//println("read_i32 = ", ans);

	return ans;
}

fn read_i32s(str_: &const str): [i32; :]
{
	// Parse a vector of positive i32 integers from a string.  Any non-int
	// characters (including "-") are treated as delimiters

	let i = i64(0);
	let n = len(str_);

	//println("str_ = ", str_);
	//println("n = ", n);

	//let toks = i64([0, 0, 0]);
	let toks = [i64(0); 3];
	let num_nums = 0;  // the number of numbers

	while toks[0] >= 0
	{
		//println("i = ", i);
		toks = tok_i32(str_[i:n]);
		//println("toks = ", toks);
		//println("num = ", num);
		num_nums += 1;
		i += toks[1] + 1;
	}
	num_nums -= 1;

	let nums = [0; num_nums];
	i = i64(0);
	for j in [0: num_nums]
	{
		//println("i = ", i);
		toks = tok_i32(str_[i:n]);
		//println("toks = ", toks);
		let num = parse_i32(str_[i + toks[0]: i + toks[1]+1]);
		//println("num = ", num);
		nums[j] = num;
		//num_nums += 1;
		i += toks[1] + 1;
	}

	return nums;
}

fn read_mi32s(str_: &const str): [i32; :]
{
	// Parse a vector of possibly negative i32 integers from a string.  Any
	// non-int characters (including "+" but not "-") are treated as delimiters

	let i = i64(0);
	let n = len(str_);

	//println("str_ = ", str_);
	//println("n = ", n);

	//let toks = i64([0, 0, 0]);
	let toks = [i64(0); 3];
	let num_nums = 0;  // the number of numbers

	while toks[0] >= 0
	{
		//println("i = ", i);
		toks = tok_mi32(str_[i:n]);
		//println("toks = ", toks);
		//println("num = ", num);
		num_nums += 1;
		i += toks[1] + 1;
	}
	num_nums -= 1;

	let nums = [0; num_nums];
	i = i64(0);
	for j in [0: num_nums]
	{
		//println("i = ", i);
		toks = tok_mi32(str_[i:n]);
		//println("toks = ", toks);
		let num = parse_i32(str_[i + toks[0]: i + toks[1]+1]);
		//println("num = ", num);
		nums[j] = num;
		//num_nums += 1;
		i += toks[1] + 1;
	}

	return nums;
}

//==============================================================================

fn verifyback(str_: &const str, set: &const str): i64
{
	//println("");
	//println("starting verifyback");
	//println("str_ = ", str_);
	//println("set  = ", set);

	let i = len(str_) - 1;
	let found = true;
	while found and i >= 0
	{
		let j = 0;
		found = false;
		while not found and j < len(set)
		{
			found = str_[i] == set[j];
			j += 1;
		}
		i -= 1;
	}

	let ans = i64(-1);
	if not found
	{
		//println("ans = ", i + 1);
		ans = i + 1;
	}
	return ans;
}

//==============================================================================

fn is_digit(char_: str): bool
{
	return i32("0") <= i32(char_) and i32(char_) <= i32("9");
}

fn is_lower(char_: str): bool
{
	return i32("a") <= i32(char_) and i32(char_) <= i32("z");
}

fn is_upper(char_: str): bool
{
	return i32("A") <= i32(char_) and i32(char_) <= i32("Z");
}

fn is_alpha(char_: str): bool
{
	return is_lower(char_) or is_upper(char_);
}

//********

const CASE_DIFF__ = i32("A") - i32("a");

fn to_lower(char_: str): str
{
	if not is_upper(char_)
		return char_;
	return char(i32(char_) - CASE_DIFF__);
}

fn to_upper(char_: str): str
{
	if not is_lower(char_)
		return char_;
	return char(i32(char_) + CASE_DIFF__);
}

//==============================================================================

// TODO: rename to any_char_eq_str or any_char_eq_set
fn any_str_eq_set(str_: &const str, set: &const str): bool
{
	return scan(str_, set) >= 0;
}

//==============================================================================

fn any_mat(v: &const [bool; :, :]): bool
{
	// This is built-in to syntran now, but keep `any_mat` for compatibility
	// with old AOC scripts which use it
	return any(v);
}

//==============================================================================

fn any_r3(v: &const [bool; :, :, :]): bool
{
	return any(v);
}

//==============================================================================

fn minloc_mat(dist: &const [i32; :, :], q: &const [bool; :, :]): [i32; :]
{
	let found = false;
	let min_ = -1;
	let minloc_ = [-1, -1];
	for y in [0: size(dist,1)]
	for x in [0: size(dist,0)]
	{
		if q[x,y]
		{
			if found
			{
				//min_ = min(min_, dist[x,y]);
				if (dist[x,y] < min_)
				{
					min_ = dist[x,y];
					minloc_ = [x, y];
				}
			}
			else
			{
				found = true;
				min_ = dist[x,y];
				minloc_ = [x, y];
			}
		}
	}
	//let ans = min_;
	return minloc_;
}

//==============================================================================

fn minloc_r3(dist: &const [i32; :, :, :], q: &const [bool; :, :, :]): [i32; :]
{
	let found = false;
	let min_ = -1;
	let minloc_ = [-1, -1];
	for z in [0: size(dist,2)]
	for y in [0: size(dist,1)]
	for x in [0: size(dist,0)]
	{
		if q[x,y,z]
		{
			if found
			{
				if (dist[x,y,z] < min_)
				{
					min_ = dist[x,y,z];
					minloc_ = [x, y, z];
				}
			}
			else
			{
				found = true;
				min_ = dist[x,y,z];
				minloc_ = [x, y, z];
			}
		}
	}
	//let ans = min_;
	return minloc_;
}

