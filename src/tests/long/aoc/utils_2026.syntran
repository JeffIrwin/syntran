fn index_(str_: &const str, substr: &const str): i64
{
	//println("str_   = ", str_);
	//println("substr = ", substr);

	let nsub = len(substr);

	let i = i64(0);
	let found = false;
	while not found and i < len(str_) - len(substr) + 1
	{
		found = str_[i: i+nsub] == substr;
		i += 1;
	}

	if found
	{
		i -= 1;
		//println("str_ = ", str_);
		//println("str_[] = ", str_[i: i + len(substr)]);
		//println("substr = ", substr);
		//println();
		return i;
	}
	else
	{
		//println("not found");
		return i64(-1);
	}
}

