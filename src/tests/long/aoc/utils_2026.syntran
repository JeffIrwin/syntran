			h = stack[top];
			top -= 1;

			l = stack[top];
			top -= 1;

			// Median-of-three pivot.  40x faster for AOC day 21!
			let m = (l + h) / 2;
			if v[ix[m]] < v[ix[l]]
			{
				let tmp = ix[m];
				ix[m]   = ix[l];
				ix[l]   = tmp;
			}
			if v[ix[h]] < v[ix[l]]
			{
				let tmp = ix[h];
				ix[h]   = ix[l];
				ix[l]   = tmp;
			}
			if v[ix[m]] < v[ix[h]]
			{
				let tmp = ix[m];
				ix[m]   = ix[h];
				ix[h]   = tmp;
			}
			let x = v[ix[h]];

			let i = (l - 1);
			for j in [l: h]
				if v[ix[j]] <= x
				{
					i += 1;
					let tmp = ix[i];
					ix[i]   = ix[j];
					ix[j]   = tmp;
				}
			let tmp = ix[i+1];
			ix[i+1] = ix[h];
			ix[h]   = tmp;
			let p = i + 1;

			if p - 1 > l
			{
				top += 1;
				stack[top] = l;

				top += 1;
				stack[top] = p - 1;
			}

			if p + 1 < h
			{
				top += 1;
				stack[top] = p + 1;

				top += 1;
				stack[top] = h;
			}
		}
	}
	return ix;
}

//==============================================================================

fn sort_inplace(v: [i32; :]): [i32; :]
{
	// Quick sort algorithm.  Return the input array but sorted (no index
	// array).  This could be DRY'd up with the index version above at the cost
	// of some time and space overhead
	//
	// TODO: arg should be passed by ref and then return nothing.  Even more
	// important for this version than sort_index()

	//println("starting sort_inplace()");
	//println("v = ", v);

	let l = 0;
	let h = size(v,0) - 1;

	if l < h
	{
		let stack = [0; h - l + 1];

		let top = -1;

		top += 1;
		stack[top] = l;

		top += 1;
		stack[top] = h;

		while top >= 0
		{
			//println("h = ", h);
			h = stack[top];
			top -= 1;

			l = stack[top];
			top -= 1;

			//// inlined
			//let p = partition(v, l, h);

			//let x = v[h];

			// Median-of-three pivot.  40x faster for AOC!
			let m = (l + h) / 2;
			if v[m] < v[l]
			{
				let tmp = v[m];
				v[m]    = v[l];
				v[l]    = tmp;
			}
			if v[h] < v[l]
			{
				let tmp = v[h];
				v[h]    = v[l];
				v[l]    = tmp;
			}
			if v[m] < v[h]
			{
				let tmp = v[m];
				v[m]    = v[h];
				v[h]    = tmp;
			}
			let x = v[h];

			let i = (l - 1);
			for j in [l: h]
				if v[j] <= x
				{
					i += 1;
					let tmp = v[i];
					v[i]  = v[j];
					v[j]  = tmp;
				}
			let tmp = v[i+1];
			v[i+1] = v[h];
			v[h] = tmp;
			let p = i + 1;

			if p - 1 > l
			{
				top += 1;
				stack[top] = l;

				top += 1;
				stack[top] = p - 1;
			}

			if p + 1 < h
			{
				top += 1;
				stack[top] = p + 1;

				top += 1;
				stack[top] = h;
			}
		}
	}
	//println("v = ", v);
	return v;
}

//==============================================================================

fn sort_inplace_i64(v: &[i64; :])
{
	// Quick sort algorithm.  Return the input array but sorted (no index
	// array)

	//println("starting sort_inplace()");
	//println("v = ", v);

	let l = 0;
	let h = size(v,0) - 1;

	if l < h
	{
		let stack = [0; h - l + 1];

		let top = -1;

		top += 1;
		stack[top] = l;

		top += 1;
		stack[top] = h;

		while top >= 0
		{
			//println("h = ", h);
			h = stack[top];
			top -= 1;

			l = stack[top];
			top -= 1;

			//// inlined
			//let p = partition(v, l, h);

			//let x = v[h];

			// Median-of-three pivot.  40x faster for AOC!
			let m = (l + h) / 2;
			if v[m] < v[l]
			{
				let tmp = v[m];
				v[m]    = v[l];
				v[l]    = tmp;
			}
			if v[h] < v[l]
			{
				let tmp = v[h];
				v[h]    = v[l];
				v[l]    = tmp;
			}
			if v[m] < v[h]
			{
				let tmp = v[m];
				v[m]    = v[h];
				v[h]    = tmp;
			}
			let x = v[h];

			let i = (l - 1);
			for j in [l: h]
				if v[j] <= x
				{
					i += 1;
					let tmp = v[i];
					v[i]  = v[j];
					v[j]  = tmp;
				}
			let tmp = v[i+1];
			v[i+1] = v[h];
			v[h] = tmp;
			let p = i + 1;

			if p - 1 > l
			{
				top += 1;
				stack[top] = l;

				top += 1;
				stack[top] = p - 1;
			}

			if p + 1 < h
			{
				top += 1;
				stack[top] = p + 1;

				top += 1;
				stack[top] = h;
			}
		}
	}
	//println("v = ", v);
	return;
}

//==============================================================================

fn uniq(v_in: &const [i32; :]): [i32; :]
{
	let v = sort_inplace(v_in);
	let u = v;

	u[0] = v[0];
	let nu = 1;
	for i in [1: size(v, 0)]
	{
		if v[i] != v[i - 1]
		{
			u[nu] = v[i];
			nu += 1;
		}
	}
	//println("u = ", u);

	// Trim
	let ut = [-1; nu];
	for i in [0: nu]
		ut[i] = u[i];

	return ut;
}

//==============================================================================

fn in_bounds(lo: &const [i32; :], x: &const [i32; :], hi: &const [i32; :]): bool
{
	// Vector bounds check.  Inclusive of lo, exclusive of hi
	for i in [0: size(x, 0)]
	{
		if (x[i] <  lo[i]) return false;
		if (x[i] >= hi[i]) return false;
	}
	return true;
}

//==============================================================================

fn cat_i32s(v: &const [i32; :]): i64
{
	// Concatenate a vector of ints, as a string, into one big number
	let str_ = "";
	for vv in v
		str_ = str_ + str(vv);
	return parse_i64(str_);
}

fn cat_strs(str_vec: &const [str; :]): str
{
	// Concatenate a vector of strings (or chars) into one big str
	//
	// The built-in str() fn is similar but wraps in [brackets] and adds comma
	// and space delimiters
	//
	// TODO: allocate once instead of multiple cats
	let str_ = "";
	for i in [0: size(str_vec, 0)]
		str_ += str_vec[i];
	return str_;
}
fn join_(str_vec: &const [str; :], delim: &const str): str
{
	// Like cat_strs() but with delimeters
	let str_ = "";
	const N = size(str_vec);
	for i in [0: N]
	{
		str_ += str_vec[i];
		if i < N-1
			str_ += delim;
	}
	return str_;
}

fn vec_str(s: &const str): [str; :]
{
	// Divide a string into a vector of chars
	let v = [""; len(s)];
	for i in [0: len(s)]
		v[i] = s[i];
	return v;
}

//==============================================================================

fn print_char_mat(chars: &const [str; :,:])
{
	for iy in [0: size(chars, 1)]
		println(cat_strs(chars[:,iy]));
	println();
	return;
}

fn print_bool_mat(b: &const [bool; :,:])
{
	// Print a bool matrix with the common AOC convention of "#" for true and
	// "." for false
	const nx = size(b,0);
	const ny = size(b,1);
	let c = ["."; nx, ny];
	for y in [0: ny]
	for x in [0: nx]
		if b[x,y]
			c[x,y] = "#";
	print_char_mat(&c);
}

fn char_mat_to_str(chars: &const [str; :,:]): str
{
	// Concatenate a char matrix with newlines as row delimiters. Non-optimal
	// string reallocation
	let s = "";
	for iy in [0: size(chars, 1)]
		s = s + cat_strs(chars[:,iy]) + NEWLINE_;
	return s;
}

fn str_to_char_mat(s: &const str, line_delim: str): [str; :,:]
{
	// Split a string, with rows delimited by a `line_delim` such as NEWLINE_,
	// into a matrix of characters
	const lines = split_(s, line_delim);
	const nx = len(lines[0]);
	const ny = size(lines);
	let mat = [" "; nx, ny];
	let y = 0;
	for line in lines
	{
		let x = 0;
		for c in line
		{
			mat[x,y] = c;
			x += 1;
		}
		y += 1;
	}
	return mat;
}

fn bool_mat_to_str(b: &const [bool; :,:]): str
{
	const nx = size(b,0);
	const ny = size(b,1);
	let s = repeat(".", i32(nx*ny));
	let k = 0;
	for y in [0: ny]
	for x in [0: nx]
	{
		if b[x,y]
			s[k] = "#";
		k += 1;
	}
	return s;
}

//==============================================================================

fn count_char(s: &const str, c: str): i32
{
	let n = 0;
	for cs in s
		if cs == c
			n += 1;
	return n;
}

//==============================================================================

fn read_char_mat(filename: str): [str; :,:]
{
	// Read a matrix of characters from a file

	//println("starting read_char_mat()");
	let ny = countln_(filename);
	//println("ny = ", ny);
	let f = open(filename, "r");
	let str_ = readln(f);
	let nx = i32(len(str_));
	let chars = [""; nx, ny];
	for y in [0: ny]
	{
		//println("str_ = ", str_);
		for x in [0: min(i32(len(str_)), nx)]
			chars[x,y] = str_[x];
		if (not eof(f)) str_ = readln(f);
	}
	close(f);
	return chars;
}

fn read_dec_mat(filename: str): [i32; :,:]
{
	// Read a dense integer matrix from a file with no delimiters. All values
	// are 0-9
	//
	// Bit of a strange fn, but this turns out to be a commot AOC parsing
	// problem
	let gc = read_char_mat(filename);
	const NX = i32(size(gc, 0));
	const NY = i32(size(gc, 1));
	let g = [0; NX, NY];
	for y in [0: NY]
	for x in [0: NX]
		g[x,y] = parse_i32(gc[x,y]);
	//println("g = ", g);
	return g;
}

//==============================================================================

fn read_i32_mat(filename: str): [i32; :,:]
{
	// Read a matrix of comma-delimited i32 integers from a file
	let delims = ", ";
	return read_i32_mat_delim(filename, delims);
}

//==============================================================================

fn read_i32_mat_delim(filename: str, delims: str): [i32; :,:]
{
	// Read a matrix of i32 integers from a file with custom delimiters
	let ny = countln_(filename);
	let f = open(filename, "r");
	let str_ = readln(f);
	let row = parse_i32_delim(str_, delims);
	let nx = size(row, 0);
	let mat = [0; nx, ny];
	for y in [0: ny]
	{
		//println("str_ = ", str_);
		const vec = parse_i32_delim(str_, delims);
		mat[:size(vec), y] = vec;
		str_ = readln(f);
	}
	close(f);
	return mat;
}

//==============================================================================

fn read_i64_mat(filename: str): [i64; :,:]
{
	// Read a matrix of comma-delimited i64 integers from a file
	let delims = ", ";
	return read_i64_mat_delim(filename, delims);
}

//==============================================================================

fn read_i64_mat_delim(filename: str, delims: str): [i64; :,:]
{
	// Read a matrix of i64 integers from a file with custom delimiters
	let ny = countln_(filename);
	let f = open(filename, "r");
	let str_ = readln(f);
	let row = parse_i64_delim(str_, delims);
	let nx = size(row, 0);
	let mat = [0'i64; nx, ny];
	for y in [0: ny]
	{
		//println("str_ = ", str_);
		mat[:,y] = parse_i64_delim(str_, delims);
		str_ = readln(f);
	}
	close(f);
	return mat;
}

//==============================================================================

fn base_n(a: i64, n: i64): [i32; :]
{
	// TODO: this is not well-tested.  I tried to use it in 2024/19 but then
	// switched to another approach without really using this.  On the other
	// hand, it is based on a base-3 converter from 2024/7

	// Convert `a` to base n.  Max 64 (base n) digits allowed.  This is ok for
	// the value of nvmax
	let DIGITS_CAP = 64;
	let res = [0'i32; DIGITS_CAP];
	let iout = -1;
	for i in [0: DIGITS_CAP]
	{
		iout = i;
		let r = a % n;
		a /= n;
		res[i] = r;  // endianness is not important for aoc problem
		if (a == 0) break;
	}
	//println("base3 = ", res);

	return res;

	//// Trimming?
	//let ndigits = iout;
	//if res[ndigits] == 0 and ndigits > 1
	//	ndigits -= 1;
	//return res[0: ndigits + 1]; // trim
}

//==============================================================================

fn next_perm(array: &[i32; :]): bool
{
	// Get the next permutation of `array` and modify it in place.  Return false
	// if we're already on the last perm
	//
	// c.f. aoc-2022/utils.f90
	let n = size(array, 0);
	let i = n - 1;
	while i > 0
	{
		if not (array[i-1] >= array[i]) break; // TODO: weird way to write a condition
		i -= 1;
	}
	if i <= 0
	{
		// This is the last permutation
		return false;
	}

	let j = n - 1;
	while array[j] <= array[i-1]
		j -= 1;

	array[[i-1, j]] = array[[j, i-1]];
	j = n - 1;
	while i < j
	{
		array[[i, j]] = array[[j, i]];
		i += 1;
		j -= 1;
	}
	return true;
}

//==============================================================================

fn factorial(n: i32): i32
{
	// Might want an i64 version too
	return product([1: n+1]);
}

//==============================================================================

fn split_str_mat(s: &const str, delims: &const str): [str; :,:]
{
	// Split a str by delimiters into a matrix of chars
	let rows = split_(s, delims);
	//println("rows = ", rows);

	let nx = len(rows[0]);
	let ny = size(rows, 0);
	//println("nx, ny = ", [nx, ny]);

	let ans = [""; nx, ny];
	for y in [0: ny]
	{
		let row = rows[y];
		for x in [0: nx]
			ans[x, y] = row[x];
	}
	return ans;
	//return ["x"; 3, 4];
}

//==============================================================================

fn readlns_(filename: str): [str; :]
{
	// Load a whole file as an array of strings
	let n = countln_(filename);
	let strs = [""; n];
	let f = open(filename, "r");
	for i in [0: n]
		strs[i] = readln(f);
	close(f);
	return strs;
}

//==============================================================================

fn count_set_bits(n: i32): i32
{
	// Kernighan's algorithm, O(set bits)
	let count = 0;
	while n > 0
	{
		n &= (n - 1);  // clears the lowest set bit
		count += 1;
	}
	return count;
}

fn count_set_bits64(n: i64): i32
{
	// Kernighan's algorithm, O(set bits)
	let count = 0;
	while n > 0
	{
		n &= (n - 1);  // clears the lowest set bit
		count += 1;
	}
	return count;
}

//==============================================================================

// Could also make an addmod() fn for `(a + b) % m` if needed
fn mulmod(a: i64, b: i64, m: i64): i64
{
	// Return `(a * b) % m` while avoiding overflow
	let result = 0'i64;
	a = pmod64(a, m);

	while (b != 0) {
		if (b & 1'i64 != 0)
			result = pmod64((result + a), m);
		a = pmod64((a + a), m);
		b >>= 1;
	}
	return result;
}

fn powmod(a: i64, b: i64, m: i64): i64
{
	// Return `a ** b % m` while avoiding overflow
	let result = 1'i64;
	a = pmod64(a, m);
	while b > 0
	{
		if b % 2 == 1
			result = mulmod(result, a, m);
		b /= 2;
		a = mulmod(a, a, m);
	}
	return result;
}

