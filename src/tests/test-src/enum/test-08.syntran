// A bare enum type name (e.g. `Suit`) is a special form, not a value: it's
// only valid as a `for` loop's iterable or as an argument to size()/str()/
// println()/writeln() (see E99).  This covers size() and `for` iteration
// over it directly, aliases and negative explicit values, and the
// array_move()/array_at() fix that lets an enum (or struct) array stored in
// a variable be iterated with `for` without crashing

enum Suit
{
	Hearts,
	Diamonds,
	Clubs,
	Spades,
}

let ok1 = size(Suit) == 4;
let ok2 = size(Suit, 0) == 4;

// Iterate a bare enum name directly
let sum1 = 0;
for s in Suit
{
	sum1 = sum1 + i32(s);
}
let ok3 = sum1 == 0 + 1 + 2 + 3;

// A *literal* enum array (not a bare enum name -- binding `Suit` itself with
// `let` is E99) is assignable, indexable, and iterable once stored in a
// variable (this last part used to internal-error -- array_move()/
// get_array_val() didn't know about enum elements)
let all = [Suit.Hearts, Suit.Diamonds, Suit.Clubs, Suit.Spades];
let ok4 = size(all) == 4;
let ok5 = all[1] == Suit.Diamonds;

let sum2 = 0;
for s in all
{
	sum2 = sum2 + i32(s);
}
let ok6 = sum2 == sum1;

let ok7 = str(Suit) == "[Suit.Hearts, Suit.Diamonds, Suit.Clubs, Suit.Spades]";

// Aliases are included in both size() and iteration
enum Card
{
	Two,
	Three,
	Jack = 10,
	Queen,
	King = Jack,
}
let ok8 = size(Card) == 5;

let last = Card.Two;
for c in Card
{
	last = c;
}
let ok9 = last == Card.King and i32(last) == 10;

// Explicit/negative values: declaration order is preserved, not value order
enum Temp
{
	Below = -1,
	Freezing,
	Above,
}
let ok10 = size(Temp) == 3;

let first = Temp.Above;
for t in Temp
{
	first = t;
	break;
}
let ok11 = first == Temp.Below;

// Empty enum: size 0, zero-trip for loop
enum Nothing {}
let ok12 = size(Nothing) == 0;
let ran = false;
for n in Nothing
{
	ran = true;
}
let ok13 = not ran;

// Regression: iterating a struct array stored in a variable shares the same
// array_move()/array_at() fix as enum arrays above (struct elements live in
// the same %struct(:) component)
struct P
{
	n: i32,
}
let ps = [P{n = 1}, P{n = 2}, P{n = 3}];
let ok14 = true;
for p in ps
{
	ok14 = ok14 and str(p) != "";
}

return ok1 and ok2 and ok3 and ok4 and ok5 and ok6 and ok7 and ok8 and ok9 and
	ok10 and ok11 and ok12 and ok13 and ok14;
