// A bare enum type name (e.g. `Suit`) is an array of all its variants, in
// declaration order.  This covers size() and `for` iteration over it,
// aliases and negative explicit values, fn param/return of a bare enum
// name, and the array_move()/array_at() fix that lets an enum (or struct)
// array stored in a variable be iterated with `for` without crashing

enum Suit
{
	Hearts,
	Diamonds,
	Clubs,
	Spades,
}

let ok1 = size(Suit) == 4;
let ok2 = size(Suit, 0) == 4;

// Iterate a bare enum name directly
let sum1 = 0;
for s in Suit
{
	sum1 = sum1 + i32(s);
}
let ok3 = sum1 == 0 + 1 + 2 + 3;

// Bare enum name as an array value: assignable, indexable, and iterable
// once stored in a variable (this last part used to internal-error --
// array_move()/get_array_val() didn't know about enum elements)
let all = Suit;
let ok4 = size(all) == 4;
let ok5 = all[1] == Suit.Diamonds;

let sum2 = 0;
for s in all
{
	sum2 = sum2 + i32(s);
}
let ok6 = sum2 == sum1;

let ok7 = str(Suit) == "[Suit.Hearts, Suit.Diamonds, Suit.Clubs, Suit.Spades]";

// Aliases are included in both size() and iteration
enum Card
{
	Two,
	Three,
	Jack = 10,
	Queen,
	King = Jack,
}
let ok8 = size(Card) == 5;

let last = Card.Two;
for c in Card
{
	last = c;
}
let ok9 = last == Card.King and i32(last) == 10;

// Explicit/negative values: declaration order is preserved, not value order
enum Temp
{
	Below = -1,
	Freezing,
	Above,
}
let ok10 = size(Temp) == 3;

let first = Temp.Above;
for t in Temp
{
	first = t;
	break;
}
let ok11 = first == Temp.Below;

// Enum array fn params/returns
fn describe_all(h: [Suit; :]): str
{
	return str(h);
}
let ok12 = describe_all(Suit) == str(Suit);

fn make_all(): [Suit; :]
{
	return Suit;
}
let ok13 = size(make_all()) == 4;
let sum3 = 0;
for s in make_all()
{
	sum3 = sum3 + i32(s);
}
let ok14 = sum3 == sum1;

// Empty enum: size 0, zero-trip for loop
enum Nothing {}
let ok15 = size(Nothing) == 0;
let ran = false;
for n in Nothing
{
	ran = true;
}
let ok16 = not ran;

// Regression: iterating a struct array stored in a variable shares the same
// array_move()/array_at() fix as enum arrays above (struct elements live in
// the same %struct(:) component)
struct P
{
	n: i32,
}
let ps = [P{n = 1}, P{n = 2}, P{n = 3}];
let ok17 = true;
for p in ps
{
	ok17 = ok17 and str(p) != "";
}

return ok1 and ok2 and ok3 and ok4 and ok5 and ok6 and ok7 and ok8 and ok9 and
	ok10 and ok11 and ok12 and ok13 and ok14 and ok15 and ok16 and ok17;
