// print() and write() are println() and writeln() without the newline.  Several
// of them can build a line, which readln() then reads back in one piece.  Values
// of any type can be written, as println() does

fn main(): bool
{
	let filename = "build/test-13.txt";

	let fo = open(filename, "w");
	write(fo, "a=", 1);
	write(fo, " b=", 2.5f, " ");
	write(fo, [1, 2, 3]);
	write(fo, true);
	writeln(fo, "!");
	writeln(fo, "second line");
	close(fo);

	let fi = open(filename, "r");
	let line1 = readln(fi);
	let line2 = readln(fi);
	close(fi);

	// print() can't be checked by reading stdout, but it shouldn't print a
	// newline, so this line has to be finished by println()
	print("print() ");
	print("test ", 13, " ");
	println("done");

	return line1 == "a=1 b=    2.500000E+00 [1, 2, 3]true!" and
		line2 == "second line";
}

return main();
