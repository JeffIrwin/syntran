
// A member, an element, or a method of the subscripted result of a call, as in
// `g()[1].x`.  The subscripts select a struct from the array that the call
// makes, and the member is read from it before the array is freed

struct In
{
	y: i32,
}

struct S
{
	x: i32,
	v: [i32; :],
	i: In,
	name: str,

	const fn items(): [S; :]
	{
		return [S{x = x + 1, v = [1], i = In{y = 1}, name = "a"},
		        S{x = x + 2, v = [6, 7], i = In{y = 2}, name = "bb"}];
	}
}

fn g(): [S; :]
{
	return [S{x = 4, v = [1, 2], i = In{y = 11}, name = "p"},
	        S{x = 5, v = [3, 4], i = In{y = 12}, name = "qq"}];
}

let k = 1;
let s = S{x = 10, v = [0], i = In{y = 0}, name = "z"};

let ok = true;
ok = ok and g()[1].x == 5;
ok = ok and g()[1].v[1] == 4;
ok = ok and all(g()[1].v[0:2] == [3, 4]);
ok = ok and g()[0].i.y == 11;
ok = ok and g()[1].name == "qq" and g()[1].name[1] == "q";
ok = ok and g()[k].x + g()[k - 1].x == 9;
ok = ok and s.items()[1].x == 12 and s.items()[0].name == "a";

return ok;
