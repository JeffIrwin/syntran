
// std::move() of local and global arrays and strs.  The moved-from variable is
// left empty, and can be assigned again

struct Pt
{
	x: i32,
	y: i32,
}

let g = [1, 2, 3];
let gs = "global";

fn check(b: bool): i32
{
	if b
		return 0;
	return 1;
}

fn take(a: [i32; :]): i32
{
	return a[0] + i32(size(a));
}

fn give(): [i32; :]
{
	let a = [4, 5, 6, 7];
	return std::move(a);
}

fn give_str(): str
{
	let s = "returned";
	return std::move(s);
}

fn glob(): i32
{
	let status = 0;

	let b = std::move(g);
	status += check(size(g) == 0);
	status += check(size(b) == 3);
	status += check(b[2] == 3);

	g = [10, 20];
	status += check(size(g) == 2);
	status += check(g[1] == 20);

	let t = std::move(gs);
	status += check(len(gs) == 0);
	status += check(t == "global");
	gs += "!";
	status += check(gs == "!");

	return status;
}

fn main(): i32
{
	let status = 0;

	// let, i32
	let a = [1, 2, 3];
	let b = std::move(a);
	status += check(size(a) == 0);
	status += check(size(b) == 3);
	status += check(b[0] == 1 and b[1] == 2 and b[2] == 3);

	// assign, then reuse the moved-from variable
	let c = [0; 2];
	c = std::move(b);
	status += check(size(b) == 0);
	status += check(size(c) == 3);
	b = [8, 9];
	status += check(size(b) == 2 and b[1] == 9);
	b[0] = 7;
	status += check(b[0] == 7);

	// other element types
	let f = [1.5, 2.5];
	let f2 = std::move(f);
	status += check(size(f) == 0 and size(f2) == 2 and f2[1] == 2.5);

	let l = [i64(1), i64(2), i64(3)];
	let l2 = std::move(l);
	status += check(size(l) == 0 and size(l2) == 3 and l2[2] == i64(3));

	let bo = [true, false];
	let bo2 = std::move(bo);
	status += check(size(bo) == 0 and size(bo2) == 2 and not bo2[1]);

	let ss = ["a", "bc", "def"];
	let ss2 = std::move(ss);
	status += check(size(ss) == 0 and size(ss2) == 3 and ss2[2] == "def");

	let ps = [Pt{x = 1, y = 2}, Pt{x = 3, y = 4}];
	let ps2 = std::move(ps);
	status += check(size(ps) == 0 and size(ps2) == 2 and ps2[1].y == 4);
	ps = [Pt{x = 5, y = 6}];
	status += check(size(ps) == 1 and ps[0].x == 5);

	// rank 2
	let m = [3; 2, 3];
	let m2 = std::move(m);
	status += check(size(m, 0) == 0 and size(m, 1) == 0);
	status += check(size(m2, 0) == 2 and size(m2, 1) == 3 and m2[1, 2] == 3);
	m = [4; 1, 2];
	status += check(size(m, 0) == 1 and size(m, 1) == 2 and m[0, 1] == 4);

	// str
	let s = "hello";
	let t = std::move(s);
	status += check(len(s) == 0 and s == "");
	status += check(t == "hello");
	s = "again";
	status += check(s == "again");
	s += "!";
	status += check(s == "again!");

	// as an arg, and from a fn
	let d = [5, 6, 7];
	status += check(take(std::move(d)) == 8);
	status += check(size(d) == 0);
	let e = give();
	status += check(size(e) == 4 and e[3] == 7);
	status += check(give_str() == "returned");

	// moving twice gives the empty array the second time
	let h = [1, 2];
	let h1 = std::move(h);
	let h2 = std::move(h);
	status += check(size(h1) == 2 and size(h2) == 0);

	// in a loop, a buffer that is refilled
	let buf = [0; 0];
	let total = 0;
	for i in [0: 4]
	{
		buf = [i; i + 1];
		let got = std::move(buf);
		total += size(got);
		status += check(size(buf) == 0);
	}
	status += check(total == 10);

	status += glob();

	return status;
}

return main();
