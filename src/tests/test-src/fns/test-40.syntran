// == and != on fn pointers.  Both aborted fatally with
// "Internal syntran error[I2]: binary operator `==`/`!=` cannot be evaluated"
// before is_eq_value_t() (bool.f90) grew a fn_type case comparing
// sca%fn_index -- is_ne_value_t() delegates to is_eq_value_t(), so no
// separate fix was needed there

fn a(n: i32): i32
{
	return n;
}

fn b(n: i32): i32
{
	return 2 * n;
}

let f = a;
let g = a;
let h = b;

// same target
let r1 = f == g;   // true
let r2 = f != g;   // false

// different targets
let r3 = f == h;   // false
let r4 = f != h;   // true

// comparison after reassignment: f now points at the same target as h
f = b;
let r5 = f == h;   // true
let r6 = f == g;   // false (g still points at a)

return str(r1) + "," + str(r2) + "," + str(r3) + "," + str(r4) + "," + str(r5) + "," + str(r6);
