// switch inside a while-loop and inside a for-loop, with break/continue in an
// arm hitting the enclosing loop (not the switch itself -- there is no
// switch-scoped break in this language)

let i = 0;
let log_ = [0, 0, 0, 0, 0];
let n = 0;
while i < 5
{
	switch i
	{
		case 2
		{
			i += 1;
			continue;
		}
		case 4
		{
			break;
		}
	}
	log_[n] = i;
	n += 1;
	i += 1;
}
let ok1 = n == 3 and log_[0] == 0 and log_[1] == 1 and log_[2] == 3;

let total = 0;
for j in [0: 6]
{
	switch j
	{
		case 3
		{
			continue;
		}
		case 5
		{
			break;
		}
	}
	total += j;
}
// 0 + 1 + 2 + 4 = 7 (3 skipped by continue, 5 and beyond cut off by break)
let ok2 = total == 7;

return ok1 and ok2;
