// Constructs that the transpiler writes in a shorter form than the general
// one, which must still do the same thing as the interpreter.  These programs
// are run by both the interpreter and the Fortran transpiler
// (utils/test-transpile.sh), which must print the same thing.  The return
// value is the number of failed checks

let status = 0;

fn check(ok: bool): i32
{
	if (ok) return 0;
	return 1;
}

//==============================================================================
// Scalar parameters are passed by value, and are free to be assigned to

fn bump(n: i32): i32
{
	n += 1;
	return n * 2;
}

fn scale(x: f64, k: i64): f64
{
	x *= 2.0;
	k += 1'i64;
	return x * k;
}

fn flip(b: bool): bool
{
	b = not b;
	return b;
}

fn rec(n: i32): i32
{
	if (n <= 0) return 0;
	n -= 1;
	return n + rec(n);
}

let v = 4;
println(bump(v), " ", v);
status += check(bump(v) == 10);
status += check(v == 4);
status += check(scale(1.5, 2'i64) == 9.0);
status += check(flip(true) == false);
status += check(rec(5) == 10);

//==============================================================================
// Range loops

fn sum_to(n: i32): i32
{
	let s = 0;
	for i in [0: n]
	{
		s += i;
	}
	return s;
}

fn add_ten(x: &i32)
{
	x += 10;
}

let t = 0;
for i in [0: 4]
{
	t += i;
}
status += check(t == 6);

t = 0;
for i in [0: 2: 10]
{
	t += i;
}
status += check(t == 20);

t = 0;
for i in [10: -3: 0]
{
	t += i;
}
status += check(t == 10 + 7 + 4 + 1);

// A loop variable that is assigned to, or passed by reference, still starts
// each iteration at the next value
t = 0;
for i in [0: 3]
{
	i += 5;
	t += i;
}
status += check(t == 5 + 6 + 7);

t = 0;
for i in [0: 3]
{
	add_ten(&i);
	t += i;
}
status += check(t == 10 + 11 + 12);

let n = 5;
t = 0;
for i in [n: -2: 0]
{
	t += i;
}
status += check(t == 5 + 3 + 1);
status += check(sum_to(5) == 10);

let t64 = 0'i64;
for i in [0'i64: 3'i64]
{
	t64 += i;
}
status += check(t64 == 3'i64);

// Nothing runs
t = 0;
for i in [3: 3]
{
	t += 1;
}
status += check(t == 0);

//==============================================================================
// Literals that are widened, and array literals

let a = [1, 2, 3];
let b = [1.5, 2.5];
let c = [true, false];
let d = [1'i64, 2'i64];
status += check(size(a, 0) == 3);
status += check(size(a) == 3);
status += check(sum(a) == 6);
status += check(sum(b) == 4.0);
status += check(c[0] and not c[1]);
status += check(sum(d) == 3'i64);

let m = [1, 2, 3, 4, 5, 6; 2, 3];
status += check(size(m, 0) == 2);
status += check(size(m, 1) == 3);
status += check(sum(m, 1)[0] == 1 + 3 + 5);

//==============================================================================
// Operations that are not wrapped in parentheses of their own are still
// grouped as syntran's tree says, which makes a difference for floats

let p = 10;
let q = 3;
let r = 4;
let w = 2;
status += check(p - (q - r) == 11);
status += check(p - q - r == 3);
status += check((p + q) * r == 52);
status += check(p + q * r == 22);
status += check(p / q * r == 12);
status += check(p / (q * r) == 0);
status += check(p % q * r == 4);
status += check(p % (q * r) == 10);
status += check(-p * q == -30);
status += check(p - -q == 13);
status += check(p ** 2 - q ** 2 * r == 64);
status += check((p - q) ** 2 == 49);
status += check(p << 1 + q == 160);
status += check((p | q) & r == 0 + (11 & 4));
println(2 ** 3 ** 2, " ", (2 ** 3) ** 2, " ", 2 ** (3 ** 2));

// `**` is right-associative and binds tighter than a unary operator, like
// Fortran.  The transpiled program leaves out the parentheses that this makes
// redundant, and has to keep the rest
status += check(2 ** 3 ** 2 == 512);
status += check((2 ** 3) ** 2 == 64);
status += check(2 ** (3 ** 2) == 512);
status += check(-p ** 2 == -100);
status += check((-p) ** 2 == 100);
status += check(-(p ** 2) == -100);
status += check(-q ** 2 * r == -36);
status += check(r * -q ** 2 == -36);
status += check(p ** -(-2) == 100);
status += check(w ** q ** w == 512);
status += check((w ** q) ** w == 64);
status += check(-w ** q ** w == -512);

let x = 0.1;
let y = 0.2;
let z = 0.3;
println(x + y - z);
println(x - (y - z));
println(x + (y + z));
println((x + y) + z);
println(x * y + z);
println(x * (y + z));
println(x / y / z);
println(x / (y / z));
println(x - y - z - x);
println(x - (y - (z - x)));

let bt = true;
let bf = false;
status += check((bt and bf) or bt);
status += check(bt and (bf or bt));
status += check(not (bt and bf));
status += check((bt == bf) == bf);
status += check((p < q) == bf);
status += check(p < q or q < r and r < w == false);
status += check((p > q and q < r) != (r < w));

let big = 3'i64;
status += check(big * (p + q) == 39'i64);
status += check(p * q + big == 33'i64);
status += check(p + big * q == 19'i64);
status += check(x + p * y == 2.1);

//==============================================================================
// println() evaluates all of its arguments before it writes any of them, and
// writes them as one line

let calls = 0;

fn say(s: str): str
{
	calls += 1;
	println("say ", s);
	return s;
}

println("a ", say("b"), " c ", say("d"), "", "!", "?");
status += check(calls == 2);
println();
println("");
println("it's ", "x");
println(1, 2.5, true, [1, 2], "x" + "y");

println(status);
return status;
