// Index-array subscripts of strings: a gather for reading and a scatter for
// assigning, like `v[[0, 3]]` for arrays.  This file is also run through the
// Fortran backend by utils/test-transpile.sh, so everything here is supported
// by --transpile

struct S
{
	s: str,
	n: [str; :],
}

fn pick(): str
{
	return "abcdef";
}

fn rev(s: str): str
{
	let idx = [0: len(s)];
	for i in [0: len(s)]
	{
		idx[i] = len(s) - 1 - i;
	}
	return s[idx];
}

let ok = true;

// Reading a string
let s = "01234567";
let a = [0, 3, 5];
ok = ok and s[a] == "035";
ok = ok and s[[7, 0]] == "70";
ok = ok and s[[0: 3]] == "012";
ok = ok and s[[0, 0, 3]] == "003";

let k = 2;
ok = ok and s[[k, k + 1]] == "23";

let i64s = [1'i64, 6'i64];
ok = ok and s[i64s] == "16";

ok = ok and rev("hello") == "olleh";
ok = ok and len(s[[1: 1]]) == 0;

// Writing a string.  The last write of a repeated index wins
let t = "abcd";
t[[0, 2]] = "xy";
ok = ok and t == "xbyd";
t[[3, 0]] = "pq";
ok = ok and t == "qbyp";
t[[1, 1]] = "mn";
ok = ok and t == "qnyp";

// Characters of the elements of a string array
let v = ["abcd", "efgh", "ijkl"];
ok = ok and v[1, [0, 2]] == "eg";

v[2, [0, 3]] = "XY";
ok = ok and v[2] == "XjkY";

v[0: 2, [1, 3]] = "mn";
ok = ok and v[0] == "amcn";
ok = ok and v[1] == "emgn";

// A string struct member
let x = S{s = "hello", n = ["abcd", "efgh"]};
ok = ok and x.s[[4, 0]] == "oh";
x.s[[0, 1]] = "HE";
ok = ok and x.s == "HEllo";
ok = ok and x.n[1, [0, 2]] == "eg";
x.n[1, [0, 2]] = "XY";
ok = ok and x.n[1] == "XfYh";

// A fn result
ok = ok and pick()[[5, 0]] == "fa";

return ok;
