
// Assigning an array of a different numeric type to a slice or a member must
// convert the elements to the type of the target's elements

struct S { a: [i32; :] }

fn main(): i32
{
	// size() is i64, so x and y are too
	let g = [0; 4, 3];
	let locs = [-1; 2, 3];
	let nlocs = 0;
	for y in [0'i64: size(g, 1)]
	for x in [0'i64: size(g, 0)]
	{
		if (x == y + 1)
		{
			locs[:, nlocs] = [x, y];
			nlocs += 1;
		}
	}
	println("locs = ", locs);

	let e = [0; 2, 2];
	e[:, 1] = [3'i64, 4'i64];

	let f = [0.0'f32; 3];
	f[0:2] = [1.5, 2.5];

	let s = S{a = [0; 3]};
	s.a[0:2] = [5'i64, 6'i64];
	let t = S{a = [0; 3]};
	t.a = [7'i64, 8'i64, 9'i64];

	let ss = [S{a = [0; 2]}];
	ss[0].a[0:2] = [1'i64, 2'i64];

	println("e = ", e);
	println("f = ", f);
	println("s = ", s);
	println("t = ", t);
	println("ss = ", ss);

	let sum_ = sum(locs) + sum(e) + sum(s.a) + sum(t.a) + sum(ss[0].a) + i32(sum(f));
	println("sum = ", sum_);
	return sum_;
}

return main();
