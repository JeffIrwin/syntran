
FROM rockylinux:9

WORKDIR /workdir

# All of the packages are installed in one layer, which then cleans up after dnf.
#
# Use gcc/gfortran 13 here because it has better glibc compatibility. Version
# gfortran 14 needs a newer glibc which doesn't pass on all of the distros
# covered by utils/test-branch.sh
#
# openblas-static is the static BLAS/LAPACK for the `@` operator and
# std::solve() (see /opt/blas-static below).  llvm-* are for the native backend
# (`syntran --native` and `--jit`, see doc/native.md).  Rocky's LLVM needs the
# libstdc++ of a newer gcc than the system's, so the toolset's static one is
# used.  The static libs are in the CRB repo
RUN dnf update -y && dnf install -y --enablerepo=crb \
	vim \
	git \
	gcc-toolset-13-gcc-gfortran \
	expect \
	openblas-static \
	llvm-devel \
	llvm-static \
	gcc-toolset-13-libstdc++-devel \
	zlib-static \
	make \
	&& dnf clean all \
	&& rm -rf /var/cache/dnf

## Static libc.a and libm.a can also be installed, but it does not remove the dependency on libc.so etc. from syntran
#dnf --enablerepo=crb install glibc-static -y

# BLAS/LAPACK for the `@` operator and std::solve().  Rocky ships a static
# OpenBLAS (CRB repo), and it's linked statically so that the shipped binary
# doesn't need any BLAS shared library at runtime, on the distros covered by
# utils/test-branch.sh.  libopenblas.a also contains LAPACK.  It isn't named
# like the -lblas -llapack in fpm.toml's `link`, so give the linker a private
# dir with only static libs of those names, first in its search path (see
# LINK_FLAG below)
RUN mkdir /opt/blas-static \
	&& ln -s /usr/lib64/libopenblas.a /opt/blas-static/libblas.a \
	&& ln -s /usr/lib64/libopenblas.a /opt/blas-static/liblapack.a

ENV PATH="$PATH:/opt/rh/gcc-toolset-13/root/usr/bin/"
RUN gfortran --version

# LLVM is linked statically too, so that the shipped binary has no
# libLLVM/libstdc++ dependency.  Rocky has no static libzstd (which LLVM's
# compression needs), so it's built from source, with -fPIC because the
# executable is a PIE.  The tarball is a mirror of facebook/zstd's release
# asset, in a release of JeffIrwin/zstd, so it has the same checksum
RUN llvm-config --version

ARG ZSTD_VERSION="1.5.7"
ARG ZSTD_SHA256="eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3"
ADD https://github.com/JeffIrwin/zstd/releases/download/v$ZSTD_VERSION/zstd-$ZSTD_VERSION.tar.gz /tmp/zstd.tar.gz
# Checked here rather than with `ADD --checksum`, which needs BuildKit
RUN echo "$ZSTD_SHA256  /tmp/zstd.tar.gz" | sha256sum -c - \
	&& tar xzf /tmp/zstd.tar.gz -C /tmp \
	&& make -C /tmp/zstd-$ZSTD_VERSION/lib -j libzstd.a CFLAGS="-O2 -fPIC" \
	&& mkdir /opt/zstd-static \
	&& cp /tmp/zstd-$ZSTD_VERSION/lib/libzstd.a /opt/zstd-static/ \
	&& rm -rf /tmp/zstd*

# fpm's `llvm-blas` feature links `-lLLVM`, but there is no monolithic static
# libLLVM.a.  Like /opt/blas-static, give the linker a private dir with a
# libLLVM.a that is first in its search path.  It's a GNU ld linker script (ld
# accepts one wherever an archive is expected, like glibc's libc.so) which
# groups the component archives that the LLVM-C calls in src/llvm_c.f90 need,
# followed by the libraries that they depend on, as static archives where
# available.  Rocky's llvm-config also asks for -lxml2, for merging Windows
# manifests, which syntran never does, so it's left out.  The `ldd` test at the
# end of this file catches any other library which ends up dynamic
RUN set -eux; \
	libs="$(llvm-config --link-static --libfiles core analysis passes target native orcjit bitreader bitwriter)"; \
	sys=""; \
	for l in $(llvm-config --link-static --system-libs); do \
		case "$l" in \
			-lxml2) ;; \
			-l*) \
				a="$(find /opt/zstd-static /usr/lib64 -maxdepth 1 -name "lib${l#-l}.a" | head -n 1)"; \
				if [ -n "$a" ]; then sys="$sys $a"; else sys="$sys $l"; fi;; \
			*) sys="$sys $l";; \
		esac; \
	done; \
	cxx="$(find /opt/rh/gcc-toolset-13 -name libstdc++.a | head -n 1)"; \
	[ -f "$cxx" ]; \
	mkdir /opt/llvm-static; \
	echo "GROUP ( $libs $cxx $sys )" > /opt/llvm-static/libLLVM.a; \
	cat /opt/llvm-static/libLLVM.a

# TODO: current FPM binary releases cannot build in parallel. Try timing a build of fpm from source with "-fopenmp" in this dockerfile to see if there's net savings. Otherwise consider migrating to cmake (possibly auto-generated by fpm)
ARG FPM_URL="https://github.com/fortran-lang/fpm/releases/download/v0.13.0/fpm-0.13.0-linux-x86_64-gcc-12"
ADD $FPM_URL /usr/local/bin/fpm
RUN chmod +x /usr/local/bin/fpm && fpm --version

ARG BRANCH="main"
RUN echo "BRANCH = $BRANCH"

#RUN git clone https://github.com/jeffirwin/syntran --branch "$BRANCH"
WORKDIR /workdir/syntran

# Copying just the src dir would usually be sufficient, but utils/gen-header.sh needs
# to know the git commit for `--version` output, so we have to install git and
# clone the whole repo
ADD src ./src
ADD external ./external
ADD .git ./.git
ADD fpm.toml .
ADD LICENSE .
ADD THIRD_PARTY_NOTICES.md .
ADD utils/gen-header.sh .

#COPY src ./src
#COPY fpm.toml .
#COPY utils/gen-header.sh .

RUN yes | fpm clean

RUN ./gen-header.sh

#RUN fpm build --compiler gfortran
#RUN fpm run   --compiler gfortran -- --version
#RUN fpm run   --compiler gfortran -- -c "1 + 2;"
#RUN fpm test test --compiler gfortran
##RUN fpm test long --compiler gfortran

ARG PROFILE="release"
#ARG PROFILE="debug"

RUN echo "PROFILE = $PROFILE"

#ARG LINK_FLAG="-static-libgcc"
#ARG LINK_FLAG="-static-libgcc -static-libgfortran"
# src/c/llvm_shim.c finds some of LLVM's fns with dlsym(), because which ones exist
# depends on the version of LLVM.  A static LLVM doesn't export its symbols, so
# dlsym() would never find them (the JIT would fail with "no way to run a module
# in its own context").  Export just the names that the shim looks up
RUN { echo '{'; grep -o 'sy_dlsym("[A-Za-z0-9_]*")' src/c/llvm_shim.c | sed 's/.*("\(.*\)")/\1;/'; echo '};'; } > /opt/llvm-static/dynamic-list.txt \
	&& cat /opt/llvm-static/dynamic-list.txt \
	&& [ "$(grep -c LLVM /opt/llvm-static/dynamic-list.txt)" -ge 2 ]

# --gc-sections drops the functions and data that nothing references, from the
# static LLVM and the rest.  It only works on a finer granularity than a whole
# object file if the sections are split up, which LLVM's archives already are, and
# SECTION_FLAGS below does for syntran's own code.  Symbols in the dynamic list
# above are still kept, and so is .init_array, so the JIT's dlsym() lookups and
# LLVM's static initializers survive
ARG LINK_FLAG="-L/opt/blas-static -L/opt/llvm-static -Wl,--dynamic-list=/opt/llvm-static/dynamic-list.txt -Wl,--gc-sections -static-libgcc -static-libgfortran -static-libquadmath"

# One section per function and per object, for the --gc-sections above.  fpm
# needs it for Fortran (--flag) and C (--c-flag) separately.  Every fpm command
# below must get the same flags, or fpm builds a second copy of everything in
# another build/gfortran_<hash>/ dir
ARG SECTION_FLAGS="-ffunction-sections -fdata-sections"

# Features can't be combined with --profile, so name the profile as a feature.
# `llvm-blas` links BLAS/LAPACK and LLVM (fpm allows only one feature with a
# `build` table) and defines SYNTRAN_LLVM.  FPM_ARGS has no spaces within its
# values, so it's expanded unquoted below; LINK_FLAG and SECTION_FLAGS have some,
# so they're quoted
ARG FPM_ARGS="--compiler gfortran --features $PROFILE,llvm-blas"

RUN fpm build $FPM_ARGS --flag "$SECTION_FLAGS" --c-flag "$SECTION_FLAGS" --link-flag "$LINK_FLAG"
RUN fpm test test $FPM_ARGS --flag "$SECTION_FLAGS" --c-flag "$SECTION_FLAGS" --link-flag "$LINK_FLAG"
# Also run every unit test program through the LLVM JIT
RUN fpm test test $FPM_ARGS --flag "$SECTION_FLAGS" --c-flag "$SECTION_FLAGS" --link-flag "$LINK_FLAG" -- --native
#RUN fpm test long $FPM_ARGS --flag "$SECTION_FLAGS" --c-flag "$SECTION_FLAGS" --link-flag "$LINK_FLAG"
# synup is a [[test]] in fpm.toml, so that a bare `fpm run` only runs syntran, and
# `fpm install` only installs it with --test.  --testdir bin puts it next to
# syntran, with `test` and `long`, which the tar below would ship if they stayed
RUN fpm install --test --testdir bin --prefix . $FPM_ARGS --flag "$SECTION_FLAGS" --c-flag "$SECTION_FLAGS" --link-flag "$LINK_FLAG" \
	&& rm ./bin/test ./bin/long

# Strip the symbol table, which is ~15 MB of a ~110 MB binary.  The dynamic
# symbols that the JIT needs for dlsym() are not part of it.  The test
# executables keep theirs for debugging, but runtime error backtraces from this
# one only have addresses.  The size is printed before and after, so a growth
# in the shipped binary shows up in the log
RUN ls -l ./bin/syntran \
	&& strip --strip-all ./bin/syntran \
	&& ls -l ./bin/syntran \
	&& size ./bin/syntran

# `fpm install --test` also put the toolchain manager in ./bin, and the tar below
# ships it.  It has no LLVM or BLAS in it, but it's linked with the same flags.
# It only needs to run on a bare distro, like syntran
RUN strip --strip-all ./bin/synup \
	&& ls -l ./bin/synup \
	&& ./bin/synup --version \
	&& ! ldd ./bin/synup | grep -E 'LLVM|stdc\+\+|libz|zstd|tinfo|openblas|gfortran|quadmath'

## Package other binary dependencies, if any
#RUN cp /lib64/libquadmath.so.0 ./bin/
#RUN cp /lib64/libgfortran.so.5 ./bin/
##RUN cp /lib64/libc.so.6 ./bin/
##RUN cp /lib64/libm.so.6 ./bin/

## The statically linked OpenBLAS/LAPACK and LLVM licenses require that their
## notices accompany the binary
RUN cp LICENSE THIRD_PARTY_NOTICES.md ./bin/

RUN cd ./bin && tar czf syntran-linux.tgz * && ls -l syntran-linux.tgz

#****************
# End installer packaging

#===========================================================
# Tests
#
# This container is kinda bulky.  Since this makes the shipped syntran binary,
# it's good to do a little extra testing here.  However, the alpine dockerfile
# runs twice as fast (~4 s cached no changes as opposed to 8 s for rocky).  For
# efficient development/debugging, these binary syntran command tests are in the
# alpine dockerfile too

RUN [[ "$(./bin/syntran -c '1+2;' | tr -d '[:space:]')" == "3" ]]
RUN [[ "$(./bin/syntran -c 'sum([0:101]);' | tr -d '[:space:]')" == "5050" ]]
RUN [[ "$(./bin/syntran -c 'sum([0:10]**2);' | tr -d '[:space:]')" == "285" ]]

RUN [[ "$(./bin/syntran -c 'let a = std::args(); size(a);' -- foo bar hello world | tr -d '[:space:]')" == "4" ]]
RUN [[ "$(./bin/syntran -c 'let a = std::args(); size(a);' -- foo bar 'hello world' | tr -d '[:space:]')" == "3" ]]

# `tr` deletes all spaces, while this `sed` only removes *leading* spaces
RUN [[ "$(./bin/syntran -c 'let a = std::args(); a[0];' -- foo bar 'hello world' | sed 's/^[[:space:]]*//')" == "foo" ]]
RUN [[ "$(./bin/syntran -c 'let a = std::args(); a[2];' -- foo bar 'hello world' | sed 's/^[[:space:]]*//')" == "hello world" ]]

# The native backend.  LLVM, libstdc++, etc. must be linked statically, so that
# the binary runs on a bare distro.  `ldd` should only list glibc-ish libs
RUN ! ldd ./bin/syntran | grep -E 'LLVM|stdc\+\+|libz|zstd|tinfo|openblas|gfortran|quadmath'
RUN [[ "$(./bin/syntran --jit -c 'sum([0:101]);' | tr -d '[:space:]')" == "5050" ]]
RUN [[ "$(./bin/syntran --jit -c 'let a = std::args(); size(a);' -- foo bar | tr -d '[:space:]')" == "2" ]]

# `--native` links with the C compiler in $CC, and this image has no `cc`.  `@`
# also links BLAS and LAPACK, which gcc resolves to the static ones through the
# private dir
ENV CC="gcc -L/opt/blas-static"
RUN ./bin/syntran --native /tmp/hello -c 'println("hello native");' \
	&& [[ "$(/tmp/hello | tr -d '[:space:]')" == "hellonative" ]]
RUN ./bin/syntran --native /tmp/mm -c 'let A = [2.0, 1.0, 1.0, 3.0; 2, 2]; println(A @ [1.0, 1.0]);' \
	&& [[ "$(/tmp/mm | tr -d '[:space:]')" == "[3.000000000000000E+00,4.000000000000000E+00]" ]]

# No-arg readln()/eof() read from stdin
RUN [[ "$(echo 'hello' | ./bin/syntran -c 'println(readln());' | tr -d '[:space:]')" == "hello" ]]
RUN [[ "$(printf 'a\nb\nc\n' | ./bin/syntran -c 'let s=""; for i in [0:3] { s += readln(); } println(s);' | tr -d '[:space:]')" == "abc" ]]
RUN [[ "$(printf 'x\n' | ./bin/syntran -c 'readln(); readln(); println(eof());' | tr -d '[:space:]')" == "true" ]]

# std::OUT writes to stdout; std::ERR writes to stderr; std::IN reads from stdin
RUN [[ "$(./bin/syntran -c 'writeln(std::OUT, "hello stdout");' | tr -d '[:space:]')" == "hellostdout" ]]
RUN [[ "$(./bin/syntran -c 'writeln(std::ERR, "hello stderr");' 2>&1 >/dev/null | tr -d '[:space:]')" == "hellostderr" ]]
RUN [[ "$(echo 'hello' | ./bin/syntran -c 'println(readln(std::IN));' | tr -d '[:space:]')" == "hello" ]]

# close() on any standard handle is a runtime error (R28)
RUN ./bin/syntran -c 'close(std::IN);'  2>&1 | grep -q "R28"
RUN ./bin/syntran -c 'close(std::OUT);' 2>&1 | grep -q "R28"
RUN ./bin/syntran -c 'close(std::ERR);' 2>&1 | grep -q "R28"

# Interactive REPL tests (isocline history, Ctrl+R search, continuation
# hints, arrow-key editing).  These need a real pty, which none of the
# piped/`-c` tests above provide -- see src/tests/repl/test-repl.sh
RUN bash src/tests/repl/test-repl.sh ./bin/syntran

